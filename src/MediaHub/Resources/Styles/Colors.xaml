<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Material 3 design tokens, brand primary #6C5CE7 -->

    <!-- ============ Light Theme ============ -->
    <Color x:Key="BackgroundLight">#F5F5F8</Color>
    <Color x:Key="SurfaceLight">#FFFFFF</Color>
    <Color x:Key="SurfaceContainerLight">#F0F0F5</Color>
    <Color x:Key="SurfaceVariantLight">#E9E9F2</Color>

    <Color x:Key="PrimaryLight">#6C5CE7</Color>
    <Color x:Key="PrimaryVariantLight">#5A4BD1</Color>
    <Color x:Key="PrimaryContainerLight">#E6E0FF</Color>
    <Color x:Key="OnPrimaryContainerLight">#312C6B</Color>
    <Color x:Key="OnPrimaryLight">#FFFFFF</Color>

    <Color x:Key="SecondaryLight">#00CEC9</Color>

    <Color x:Key="OnSurfaceLight">#1A1A2E</Color>
    <Color x:Key="OnSurfaceVariantLight">#4E4E5C</Color>

    <Color x:Key="OutlineLight">#D6D6E0</Color>
    <Color x:Key="DividerLight">#E8E8F0</Color>

    <Color x:Key="ErrorLight">#C62828</Color>
    <Color x:Key="ErrorContainerLight">#FFE3E0</Color>
    <Color x:Key="OnErrorContainerLight">#7A1414</Color>
    <Color x:Key="OnErrorLight">#FFFFFF</Color>

    <Color x:Key="SuccessLight">#2E7D32</Color>
    <Color x:Key="SuccessContainerLight">#D9F2DC</Color>
    <Color x:Key="OnSuccessContainerLight">#14541A</Color>

    <Color x:Key="ShadowLight">#000000</Color>

    <!-- Platform accents (light) -->
    <Color x:Key="TikTokLight">#FE2C55</Color>
    <Color x:Key="TikTokContainerLight">#FFE7EE</Color>
    <Color x:Key="OnTikTokContainerLight">#8E0025</Color>

    <Color x:Key="YouTubeLight">#FF0000</Color>
    <Color x:Key="YouTubeContainerLight">#FFE5E5</Color>
    <Color x:Key="OnYouTubeContainerLight">#8E0000</Color>

    <Color x:Key="SoundCloudLight">#FF6A00</Color>
    <Color x:Key="SoundCloudContainerLight">#FFF0E0</Color>
    <Color x:Key="OnSoundCloudContainerLight">#7A3300</Color>

    <Color x:Key="VKLight">#0077FF</Color>
    <Color x:Key="VKContainerLight">#E0EFFF</Color>
    <Color x:Key="OnVKContainerLight">#00458F</Color>

    <Color x:Key="VimeoLight">#1AB7EA</Color>
    <Color x:Key="VimeoContainerLight">#DFF5FD</Color>
    <Color x:Key="OnVimeoContainerLight">#00597A</Color>

    <!-- ============ Dark Theme ============ -->
    <Color x:Key="BackgroundDark">#0F0F1A</Color>
    <Color x:Key="SurfaceDark">#1A1A2E</Color>
    <Color x:Key="SurfaceContainerDark">#20203A</Color>
    <Color x:Key="SurfaceVariantDark">#252540</Color>

    <Color x:Key="PrimaryDark">#A29BFE</Color>
    <Color x:Key="PrimaryVariantDark">#6C5CE7</Color>
    <Color x:Key="PrimaryContainerDark">#3D3480</Color>
    <Color x:Key="OnPrimaryContainerDark">#DCD5FF</Color>
    <Color x:Key="OnPrimaryDark">#1A1A2E</Color>

    <Color x:Key="SecondaryDark">#00CEC9</Color>

    <Color x:Key="OnSurfaceDark">#EEEEEE</Color>
    <Color x:Key="OnSurfaceVariantDark">#B0B0BE</Color>

    <Color x:Key="OutlineDark">#333355</Color>
    <Color x:Key="DividerDark">#262640</Color>

    <Color x:Key="ErrorDark">#FF6B6B</Color>
    <Color x:Key="ErrorContainerDark">#5C1A1A</Color>
    <Color x:Key="OnErrorContainerDark">#FFC9C9</Color>
    <Color x:Key="OnErrorDark">#1A1A2E</Color>

    <Color x:Key="SuccessDark">#4ADE80</Color>
    <Color x:Key="SuccessContainerDark">#0F3D24</Color>
    <Color x:Key="OnSuccessContainerDark">#A7F3C9</Color>

    <Color x:Key="ShadowDark">#000000</Color>

    <!-- Platform accents (dark) -->
    <Color x:Key="TikTokDark">#FF3B5C</Color>
    <Color x:Key="TikTokContainerDark">#4A0F1D</Color>
    <Color x:Key="OnTikTokContainerDark">#FFC9D4</Color>

    <Color x:Key="YouTubeDark">#FF6B6B</Color>
    <Color x:Key="YouTubeContainerDark">#4A1414</Color>
    <Color x:Key="OnYouTubeContainerDark">#FFC9C9</Color>

    <Color x:Key="SoundCloudDark">#FF8A3D</Color>
    <Color x:Key="SoundCloudContainerDark">#4A2410</Color>
    <Color x:Key="OnSoundCloudContainerDark">#FFDCC4</Color>

    <Color x:Key="VKDark">#4D9BFF</Color>
    <Color x:Key="VKContainerDark">#0A2A55</Color>
    <Color x:Key="OnVKContainerDark">#C9E2FF</Color>

    <Color x:Key="VimeoDark">#4FC3EA</Color>
    <Color x:Key="VimeoContainerDark">#0A3345</Color>
    <Color x:Key="OnVimeoContainerDark">#C9ECFA</Color>

</ResourceDictionary>
