<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Design tokens. Dark theme is the headline (violet-tinted surfaces,
         deep violet #7C3AED accent, violet #8B5CF6 secondary). -->

    <!-- ============ Light Theme ============ -->
    <Color x:Key="BackgroundLight">#F7F5FC</Color>
    <Color x:Key="SurfaceLight">#FFFFFF</Color>
    <Color x:Key="SurfaceContainerLight">#F1EDF9</Color>
    <Color x:Key="SurfaceVariantLight">#EBE6F7</Color>

    <Color x:Key="PrimaryLight">#7C3AED</Color>
    <Color x:Key="PrimaryVariantLight">#6D28D9</Color>
    <Color x:Key="PrimaryContainerLight">#EDE9FE</Color>
    <Color x:Key="OnPrimaryContainerLight">#4C1D95</Color>
    <Color x:Key="OnPrimaryLight">#FFFFFF</Color>

    <Color x:Key="SecondaryLight">#8B5CF6</Color>

    <Color x:Key="OnSurfaceLight">#1A1A2E</Color>
    <Color x:Key="OnSurfaceVariantLight">#4E4E5C</Color>

    <Color x:Key="OutlineLight">#D9D4E6</Color>
    <Color x:Key="DividerLight">#EAE6F4</Color>

    <Color x:Key="ErrorLight">#C62828</Color>
    <Color x:Key="ErrorContainerLight">#FFE3E0</Color>
    <Color x:Key="OnErrorContainerLight">#7A1414</Color>
    <Color x:Key="OnErrorLight">#FFFFFF</Color>

    <Color x:Key="SuccessLight">#2E7D32</Color>
    <Color x:Key="SuccessContainerLight">#D9F2DC</Color>
    <Color x:Key="OnSuccessContainerLight">#14541A</Color>

    <Color x:Key="ShadowLight">#000000</Color>

    <!-- Platform accents (light) -->
    <Color x:Key="TikTokLight">#FE2C55</Color>
    <Color x:Key="TikTokContainerLight">#FFE7EE</Color>
    <Color x:Key="OnTikTokContainerLight">#8E0025</Color>

    <Color x:Key="YouTubeLight">#FF0000</Color>
    <Color x:Key="YouTubeContainerLight">#FFE5E5</Color>
    <Color x:Key="OnYouTubeContainerLight">#8E0000</Color>

    <Color x:Key="SoundCloudLight">#FF6A00</Color>
    <Color x:Key="SoundCloudContainerLight">#FFF0E0</Color>
    <Color x:Key="OnSoundCloudContainerLight">#7A3300</Color>

    <Color x:Key="VKLight">#0077FF</Color>
    <Color x:Key="VKContainerLight">#E0EFFF</Color>
    <Color x:Key="OnVKContainerLight">#00458F</Color>

    <Color x:Key="OKLight">#EE8208</Color>
    <Color x:Key="OKContainerLight">#FFE9D6</Color>
    <Color x:Key="OnOKContainerLight">#8A4A00</Color>

    <Color x:Key="DailymotionLight">#0D0D0D</Color>
    <Color x:Key="DailymotionContainerLight">#ECECEC</Color>
    <Color x:Key="OnDailymotionContainerLight">#141414</Color>

    <Color x:Key="VimeoLight">#1AB7EA</Color>
    <Color x:Key="VimeoContainerLight">#D8EEF7</Color>
    <Color x:Key="OnVimeoContainerLight">#005E84</Color>

    <!-- ============ Dark Theme ============ -->
    <Color x:Key="BackgroundDark">#0C0A18</Color>
    <Color x:Key="SurfaceDark">#141124</Color>
    <Color x:Key="SurfaceContainerDark">#1C1730</Color>
    <Color x:Key="SurfaceVariantDark">#191431</Color>

    <Color x:Key="PrimaryDark">#8B5CF6</Color>
    <Color x:Key="PrimaryVariantDark">#7C3AED</Color>
    <Color x:Key="PrimaryContainerDark">#2E1065</Color>
    <Color x:Key="OnPrimaryContainerDark">#DDD6FE</Color>
    <Color x:Key="OnPrimaryDark">#FFFFFF</Color>

    <Color x:Key="SecondaryDark">#A78BFA</Color>

    <Color x:Key="OnSurfaceDark">#F3F4F6</Color>
    <Color x:Key="OnSurfaceVariantDark">#9CA3AF</Color>

    <Color x:Key="OutlineDark">#2E2742</Color>
    <Color x:Key="DividerDark">#2E2742</Color>

    <Color x:Key="ErrorDark">#F87171</Color>
    <Color x:Key="ErrorContainerDark">#3B1116</Color>
    <Color x:Key="OnErrorContainerDark">#FFC9CE</Color>
    <Color x:Key="OnErrorDark">#FFFFFF</Color>

    <Color x:Key="SuccessDark">#4ADE80</Color>
    <Color x:Key="SuccessContainerDark">#0E2E1C</Color>
    <Color x:Key="OnSuccessContainerDark">#A7F3C9</Color>

    <Color x:Key="ShadowDark">#000000</Color>

    <!-- Platform accents (dark) -->
    <Color x:Key="TikTokDark">#FE2C55</Color>
    <Color x:Key="TikTokContainerDark">#3A0F1C</Color>
    <Color x:Key="OnTikTokContainerDark">#FFC9D4</Color>

    <Color x:Key="YouTubeDark">#FF4D4D</Color>
    <Color x:Key="YouTubeContainerDark">#3A1414</Color>
    <Color x:Key="OnYouTubeContainerDark">#FFB3B3</Color>

    <Color x:Key="SoundCloudDark">#FF8A3D</Color>
    <Color x:Key="SoundCloudContainerDark">#3A2410</Color>
    <Color x:Key="OnSoundCloudContainerDark">#FFDCC4</Color>

    <Color x:Key="VKDark">#4D9BFF</Color>
    <Color x:Key="VKContainerDark">#0A2A55</Color>
    <Color x:Key="OnVKContainerDark">#C9E2FF</Color>

    <Color x:Key="OKDark">#F59E0B</Color>
    <Color x:Key="OKContainerDark">#3A2810</Color>
    <Color x:Key="OnOKContainerDark">#FFD9A8</Color>

    <Color x:Key="DailymotionDark">#8A8A8A</Color>
    <Color x:Key="DailymotionContainerDark">#2A2A2A</Color>
    <Color x:Key="OnDailymotionContainerDark">#E8E8E8</Color>

    <Color x:Key="VimeoDark">#4DC7F0</Color>
    <Color x:Key="VimeoContainerDark">#0A2A3A</Color>
    <Color x:Key="OnVimeoContainerDark">#A8E2FF</Color>

</ResourceDictionary>
