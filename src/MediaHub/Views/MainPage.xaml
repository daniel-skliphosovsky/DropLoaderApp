<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MediaHub.ViewModels"
             xmlns:models="clr-namespace:MediaHub.Models"
             xmlns:anim="clr-namespace:MediaHub.Animations"
             x:Class="MediaHub.Views.MainPage"
             x:DataType="vm:MainViewModel"
             BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}"
             Shell.NavBarIsVisible="False"
             Shell.FlyoutBehavior="Disabled">

    <ContentPage.Resources>

        <!-- One row of the bottom activity log: icon + message + time + remove -->
        <DataTemplate x:Key="LogEntryTemplate" x:DataType="models:LogEntry">
            <Border Padding="10,7" Margin="0,2"
                    StrokeThickness="0" StrokeShape="RoundRectangle 10"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceVariantLight}, Dark={StaticResource SurfaceVariantDark}}">
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding Kind}" Value="success">
                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SuccessContainerLight}, Dark={StaticResource SuccessContainerDark}}" />
                    </DataTrigger>
                    <DataTrigger TargetType="Border" Binding="{Binding Kind}" Value="error">
                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ErrorContainerLight}, Dark={StaticResource ErrorContainerDark}}" />
                    </DataTrigger>
                </Border.Triggers>
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">

                    <!-- Status/platform icon: a filled platform square plus a
                         white inner glyph, or a plain stroke glyph -->
                    <Grid Grid.Column="0" WidthRequest="24" HeightRequest="24" VerticalOptions="Center">
                        <Path Data="{Binding IconData}"
                              Fill="Transparent"
                              Stroke="{AppThemeBinding Light={StaticResource OnSurfaceVariantLight}, Dark={StaticResource OnSurfaceVariantDark}}"
                              StrokeThickness="1.8" StrokeLineCap="Round" StrokeLineJoin="Round"
                              Aspect="Uniform" WidthRequest="24" HeightRequest="24"
                              VerticalOptions="Center" HorizontalOptions="Center">
                            <Path.Triggers>
                                <DataTrigger TargetType="Path" Binding="{Binding Kind}" Value="success">
                                    <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource OnSuccessContainerLight}, Dark={StaticResource OnSuccessContainerDark}}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Path" Binding="{Binding Kind}" Value="error">
                                    <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource OnErrorContainerLight}, Dark={StaticResource OnErrorContainerDark}}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Path" Binding="{Binding PlatformKey}" Value="tiktok">
                                    <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource TikTokLight}, Dark={StaticResource TikTokDark}}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Path" Binding="{Binding PlatformKey}" Value="youtube">
                                    <Setter Property="Fill" Value="{AppThemeBinding Light={StaticResource YouTubeLight}, Dark={StaticResource YouTubeDark}}" />
                                    <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource YouTubeLight}, Dark={StaticResource YouTubeDark}}" />
                                    <Setter Property="StrokeThickness" Value="0" />
                                </DataTrigger>
                                <DataTrigger TargetType="Path" Binding="{Binding PlatformKey}" Value="soundcloud">
                                    <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource SoundCloudLight}, Dark={StaticResource SoundCloudDark}}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Path" Binding="{Binding PlatformKey}" Value="vk">
                                    <Setter Property="Fill" Value="{AppThemeBinding Light={StaticResource VKLight}, Dark={StaticResource VKDark}}" />
                                    <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource VKLight}, Dark={StaticResource VKDark}}" />
                                    <Setter Property="StrokeThickness" Value="0" />
                                </DataTrigger>
                            </Path.Triggers>
                        </Path>
                        <!-- White glyph on top of a filled logo (VK letters,
                             YouTube play triangle); hidden for others. -->
                        <Path Data="{Binding GlyphData}"
                              Fill="White" StrokeThickness="0"
                              Aspect="Uniform" WidthRequest="24" HeightRequest="24"
                              VerticalOptions="Center" HorizontalOptions="Center"
                              IsVisible="False">
                            <Path.Triggers>
                                <DataTrigger TargetType="Path" Binding="{Binding PlatformKey}" Value="youtube">
                                    <Setter Property="IsVisible" Value="True" />
                                </DataTrigger>
                                <DataTrigger TargetType="Path" Binding="{Binding PlatformKey}" Value="vk">
                                    <Setter Property="IsVisible" Value="True" />
                                </DataTrigger>
                            </Path.Triggers>
                        </Path>
                    </Grid>

                    <Label Grid.Column="1"
                           Text="{Binding Message}"
                           FontSize="13" MaxLines="1" LineBreakMode="TailTruncation"
                           VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariantLight}, Dark={StaticResource OnSurfaceVariantDark}}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding Kind}" Value="success">
                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnSuccessContainerLight}, Dark={StaticResource OnSuccessContainerDark}}" />
                            </DataTrigger>
                            <DataTrigger TargetType="Label" Binding="{Binding Kind}" Value="error">
                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnErrorContainerLight}, Dark={StaticResource OnErrorContainerDark}}" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>

                    <Label Grid.Column="2"
                           Text="{Binding TimeText}"
                           FontSize="11"
                           VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariantLight}, Dark={StaticResource OnSurfaceVariantDark}}" />

                    <!-- Remove row -->
                    <Border Grid.Column="3" WidthRequest="20" HeightRequest="20"
                            StrokeThickness="0" StrokeShape="RoundRectangle 6"
                            BackgroundColor="Transparent" VerticalOptions="Center"
                            SemanticProperties.Description="Remove this log entry">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnRemoveLogTapped"
                                                  CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <Path Fill="Transparent"
                              Stroke="{AppThemeBinding Light={StaticResource OnSurfaceVariantLight}, Dark={StaticResource OnSurfaceVariantDark}}"
                              StrokeThickness="2" StrokeLineCap="Round"
                              Aspect="Uniform" WidthRequest="10" HeightRequest="10"
                              VerticalOptions="Center" HorizontalOptions="Center"
                              Data="M6 6l12 12 M18 6L6 18" />
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="0">

        <!-- ================= Header ================= -->
        <Border Grid.Row="0" StrokeThickness="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16"
                  Padding="32,16,32,14">

                <HorizontalStackLayout Spacing="14" VerticalOptions="Center">
                    <Image Source="mediahub_logo.svg" WidthRequest="44" HeightRequest="44"
                           Aspect="AspectFit" VerticalOptions="Center"
                           SemanticProperties.Description="MediaHub logo" />
                    <VerticalStackLayout VerticalOptions="Center" Spacing="0">
                        <Label Text="MediaHub" Style="{StaticResource AppTitleLabel}" FontSize="24" />
                        <Label Text="Download from TikTok, YouTube, SoundCloud and VK"
                               Style="{StaticResource AppSubtitleLabel}" FontSize="13" />
                    </VerticalStackLayout>

                    <!-- GitHub repo link -->
                    <Border WidthRequest="36" HeightRequest="36"
                            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceVariantLight}, Dark={StaticResource SurfaceVariantDark}}"
                            StrokeThickness="0" StrokeShape="RoundRectangle 10"
                            VerticalOptions="Center" Margin="6,0,0,0"
                            SemanticProperties.Description="Open the MediaHub repository on GitHub">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnGitHubTapped" />
                        </Border.GestureRecognizers>
                        <Path Fill="{AppThemeBinding Light={StaticResource OnSurfaceLight}, Dark={StaticResource OnSurfaceDark}}"
                              StrokeThickness="0" Aspect="Uniform"
                              WidthRequest="20" HeightRequest="20"
                              VerticalOptions="Center" HorizontalOptions="Center"
                              Data="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56 0-.27-.01-1.17-.02-2.12-3.2.7-3.88-1.36-3.88-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.72-1.54-2.55-.29-5.23-1.28-5.23-5.68 0-1.26.45-2.28 1.18-3.09-.12-.29-.51-1.46.11-3.04 0 0 .96-.31 3.15 1.18a10.9 10.9 0 0 1 5.74 0c2.19-1.49 3.15-1.18 3.15-1.18.62 1.58.23 2.75.11 3.04.73.81 1.18 1.83 1.18 3.09 0 4.41-2.69 5.38-5.25 5.67.41.35.77 1.05.77 2.12 0 1.53-.01 2.76-.01 3.14 0 .3.2.67.8.55A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z" />
                    </Border>
                </HorizontalStackLayout>

                <!-- Theme toggle (always the moon, taps to switch themes) -->
                <Border Grid.Column="2" Style="{StaticResource IconButton}" VerticalOptions="Center"
                        SemanticProperties.Description="Switch between light and dark theme">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleThemeCommand}" />
                    </Border.GestureRecognizers>
                    <Path Fill="Transparent"
                          Stroke="{AppThemeBinding Light={StaticResource OnSurfaceLight}, Dark={StaticResource OnSurfaceDark}}"
                          StrokeThickness="2" StrokeLineCap="Round" StrokeLineJoin="Round"
                          Aspect="Uniform" WidthRequest="22" HeightRequest="22"
                          VerticalOptions="Center" HorizontalOptions="Center"
                          Data="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
                </Border>
            </Grid>
        </Border>
        <BoxView Grid.Row="0" HeightRequest="1" VerticalOptions="End"
                 Color="{AppThemeBinding Light={StaticResource DividerLight}, Dark={StaticResource DividerDark}}" />

        <!-- ================= Main content ================= -->
        <ScrollView Grid.Row="1" SizeChanged="OnScrollViewSizeChanged">
            <Grid x:Name="ContentHost">
                <VerticalStackLayout Padding="36,36,36,24" Spacing="0"
                                     MaximumWidthRequest="760"
                                     HorizontalOptions="Center" VerticalOptions="Center">
                    <VerticalStackLayout Spacing="20">

                        <Border Style="{StaticResource CardBorder}" Padding="32,26">
                            <VerticalStackLayout Spacing="20">

                                <!-- URL row: input + download -->
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <Border Style="{StaticResource InputContainer}">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">

                                            <!-- Platform icon, auto-detected -->
                                            <Grid Grid.Column="0" WidthRequest="22" HeightRequest="22"
                                                  VerticalOptions="Center" Margin="14,0,0,0">
                                                <!-- Unknown: generic link -->
                                                <Path Fill="Transparent" IsVisible="False"
                                                      Stroke="{AppThemeBinding Light={StaticResource OnSurfaceVariantLight}, Dark={StaticResource OnSurfaceVariantDark}}"
                                                      StrokeThickness="2" StrokeLineCap="Round" StrokeLineJoin="Round"
                                                      Aspect="Uniform"
                                                      Data="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71 M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71">
                                                    <Path.Triggers>
                                                        <DataTrigger TargetType="Path" Binding="{Binding PlatformKey}" Value="unknown">
                                                            <Setter Property="IsVisible" Value="True" />
                                                        </DataTrigger>
                                                    </Path.Triggers>
                                                </Path>
                                                <!-- TikTok: music note -->
                                                <Path Fill="Transparent" IsVisible="False"
                                                      Stroke="{AppThemeBinding Light={StaticResource TikTokLight}, Dark={StaticResource TikTokDark}}"
                                                      StrokeThickness="2" StrokeLineCap="Round" StrokeLineJoin="Round"
                                                      Aspect="Uniform"
                                                      Data="M9 18V5l12-2v13 M9 18a3 3 0 1 1-6 0 3 3 0 0 1 6 0z M21 16a3 3 0 1 1-6 0 3 3 0 0 1 6 0z">
                                                    <Path.Triggers>
                                                        <DataTrigger TargetType="Path" Binding="{Binding PlatformKey}" Value="tiktok">
                                                            <Setter Property="IsVisible" Value="True" />
                                                        </DataTrigger>
                                                    </Path.Triggers>
                                                </Path>
                                                <!-- YouTube: red rounded square, play triangle
                                                     inset from the edges (official proportions) -->
                                                <Path Fill="{AppThemeBinding Light={StaticResource YouTubeLight}, Dark={StaticResource YouTubeDark}}" IsVisible="False"
                                                      StrokeThickness="0" Aspect="Uniform"
                                                      Data="M4.5 7A3.5 3.5 0 0 1 8 3.5h8A3.5 3.5 0 0 1 19.5 7v10a3.5 3.5 0 0 1-3.5 3.5H8A3.5 3.5 0 0 1 4.5 17z">
                                                    <Path.Triggers>
                                                        <DataTrigger TargetType="Path" Binding="{Binding PlatformKey}" Value="youtube">
                                                            <Setter Property="IsVisible" Value="True" />
                                                        </DataTrigger>
                                                    </Path.Triggers>
                                                </Path>
                                                <Path Fill="White" IsVisible="False"
                                                      StrokeThickness="0" Aspect="Uniform"
                                                      Data="M10.6 8.8v6.4l5.4-3.2z">
                                                    <Path.Triggers>
                                                        <DataTrigger TargetType="Path" Binding="{Binding PlatformKey}" Value="youtube">
                                                            <Setter Property="IsVisible" Value="True" />
                                                        </DataTrigger>
                                                    </Path.Triggers>
                                                </Path>
                                                <!-- SoundCloud: sound waves -->
                                                <Path Fill="Transparent" IsVisible="False"
                                                      Stroke="{AppThemeBinding Light={StaticResource SoundCloudLight}, Dark={StaticResource SoundCloudDark}}"
                                                      StrokeThickness="2.2" StrokeLineCap="Round"
                                                      Aspect="Uniform"
                                                      Data="M2 13v-2 M5 13V9 M8 13V6 M11 13V8 M14 13v-3">
                                                    <Path.Triggers>
                                                        <DataTrigger TargetType="Path" Binding="{Binding PlatformKey}" Value="soundcloud">
                                                            <Setter Property="IsVisible" Value="True" />
                                                        </DataTrigger>
                                                    </Path.Triggers>
                                                </Path>
                                                <!-- VK: bigger blue rounded square, "VK" letters
                                                     inset from the edges (official proportions) -->
                                                <Path Fill="{AppThemeBinding Light={StaticResource VKLight}, Dark={StaticResource VKDark}}" IsVisible="False"
                                                      StrokeThickness="0" Aspect="Uniform"
                                                      Data="M5.5 5A2.5 2.5 0 0 1 8 2.5h8A2.5 2.5 0 0 1 18.5 5v14a2.5 2.5 0 0 1-2.5 2.5H8A2.5 2.5 0 0 1 5.5 19z">
                                                    <Path.Triggers>
                                                        <DataTrigger TargetType="Path" Binding="{Binding PlatformKey}" Value="vk">
                                                            <Setter Property="IsVisible" Value="True" />
                                                        </DataTrigger>
                                                    </Path.Triggers>
                                                </Path>
                                                <Path Fill="White" IsVisible="False"
                                                      StrokeThickness="0" Aspect="Uniform"
                                                      Data="M8.6 8.6l1.9 5 1.9-5h1.6l-2.7 7.2h-1.6L6.9 8.6z">
                                                    <Path.Triggers>
                                                        <DataTrigger TargetType="Path" Binding="{Binding PlatformKey}" Value="vk">
                                                            <Setter Property="IsVisible" Value="True" />
                                                        </DataTrigger>
                                                    </Path.Triggers>
                                                </Path>
                                            </Grid>

                                            <Entry Grid.Column="1"
                                                   Text="{Binding Url}"
                                                   Placeholder="Paste a link to a video, track or photo set..."
                                                   Keyboard="Url"
                                                   IsEnabled="{Binding IsDownloading, Converter={StaticResource InverseBoolConverter}}"
                                                   Style="{StaticResource InputEntry}"
                                                   VerticalOptions="Center"
                                                   SemanticProperties.Hint="Paste a TikTok, YouTube or SoundCloud link" />
                                        </Grid>
                                    </Border>

                                    <Button Grid.Column="1" Text="Download"
                                            Command="{Binding DownloadCommand}"
                                            IsEnabled="{Binding CanStartDownload}"
                                            Style="{StaticResource DownloadButton}"
                                            HeightRequest="56" Padding="20,0"
                                            VerticalOptions="Center"
                                            SemanticProperties.Description="Start downloading the media" />
                                </Grid>

                                <!-- Platform chip -->
                                <Border Style="{StaticResource ChipStyle}"
                                        IsVisible="{Binding ShowPlatformBadge}"
                                        HorizontalOptions="Start">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border"
                                                     Binding="{Binding ShowPlatformBadge}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <anim:FadeInAction />
                                            </DataTrigger.EnterActions>
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding PlatformKey}" Value="tiktok">
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource TikTokContainerLight}, Dark={StaticResource TikTokContainerDark}}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding PlatformKey}" Value="youtube">
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource YouTubeContainerLight}, Dark={StaticResource YouTubeContainerDark}}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding PlatformKey}" Value="soundcloud">
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SoundCloudContainerLight}, Dark={StaticResource SoundCloudContainerDark}}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding PlatformKey}" Value="vk">
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource VKContainerLight}, Dark={StaticResource VKContainerDark}}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Label Text="{Binding PlatformName}" FontSize="13" FontAttributes="Bold" VerticalOptions="Center">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding PlatformKey}" Value="tiktok">
                                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnTikTokContainerLight}, Dark={StaticResource OnTikTokContainerDark}}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding PlatformKey}" Value="youtube">
                                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnYouTubeContainerLight}, Dark={StaticResource OnYouTubeContainerDark}}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding PlatformKey}" Value="soundcloud">
                                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnSoundCloudContainerLight}, Dark={StaticResource OnSoundCloudContainerDark}}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding PlatformKey}" Value="vk">
                                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnVKContainerLight}, Dark={StaticResource OnVKContainerDark}}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Border>

                                <!-- Metadata card: what will be downloaded -->
                                <Border IsVisible="{Binding ShowPreviewSection}"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceContainerLight}, Dark={StaticResource SurfaceContainerDark}}"
                                        StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="18">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border"
                                                     Binding="{Binding ShowPreviewSection}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <anim:FadeInAction />
                                            </DataTrigger.EnterActions>
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="14">

                                        <!-- Platform, title, author, description, duration -->
                                        <VerticalStackLayout Spacing="8">
                                                <Border Style="{StaticResource ChipStyle}"
                                                        Padding="10,3" HorizontalOptions="Start"
                                                        IsVisible="{Binding ShowPlatformBadge}">
                                                    <Border.Triggers>
                                                        <DataTrigger TargetType="Border" Binding="{Binding PlatformKey}" Value="tiktok">
                                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource TikTokContainerLight}, Dark={StaticResource TikTokContainerDark}}" />
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Border" Binding="{Binding PlatformKey}" Value="youtube">
                                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource YouTubeContainerLight}, Dark={StaticResource YouTubeContainerDark}}" />
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Border" Binding="{Binding PlatformKey}" Value="soundcloud">
                                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SoundCloudContainerLight}, Dark={StaticResource SoundCloudContainerDark}}" />
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Border" Binding="{Binding PlatformKey}" Value="vk">
                                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource VKContainerLight}, Dark={StaticResource VKContainerDark}}" />
                                                        </DataTrigger>
                                                    </Border.Triggers>
                                                    <Label Text="{Binding PlatformName}" FontSize="12" FontAttributes="Bold">
                                                        <Label.Triggers>
                                                            <DataTrigger TargetType="Label" Binding="{Binding PlatformKey}" Value="tiktok">
                                                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnTikTokContainerLight}, Dark={StaticResource OnTikTokContainerDark}}" />
                                                            </DataTrigger>
                                                            <DataTrigger TargetType="Label" Binding="{Binding PlatformKey}" Value="youtube">
                                                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnYouTubeContainerLight}, Dark={StaticResource OnYouTubeContainerDark}}" />
                                                            </DataTrigger>
                                                            <DataTrigger TargetType="Label" Binding="{Binding PlatformKey}" Value="soundcloud">
                                                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnSoundCloudContainerLight}, Dark={StaticResource OnSoundCloudContainerDark}}" />
                                                            </DataTrigger>
                                                            <DataTrigger TargetType="Label" Binding="{Binding PlatformKey}" Value="vk">
                                                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnVKContainerLight}, Dark={StaticResource OnVKContainerDark}}" />
                                                            </DataTrigger>
                                                        </Label.Triggers>
                                                    </Label>
                                                </Border>

                                                <Label Text="{Binding PreviewTitle}"
                                                       FontSize="16" FontAttributes="Bold"
                                                       FontFamily="OpenSansSemibold"
                                                       MaxLines="2" LineBreakMode="TailTruncation"
                                                       TextColor="{AppThemeBinding Light={StaticResource OnSurfaceLight}, Dark={StaticResource OnSurfaceDark}}" />
                                                <Label Text="{Binding PreviewAuthor}"
                                                       IsVisible="{Binding HasPreviewAuthor}"
                                                       FontSize="13" LineBreakMode="TailTruncation"
                                                       TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariantLight}, Dark={StaticResource OnSurfaceVariantDark}}" />
                                                <Label Text="{Binding PreviewDescription}"
                                                       IsVisible="{Binding HasPreviewDescription}"
                                                       FontSize="13" MaxLines="3" LineBreakMode="TailTruncation"
                                                       TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariantLight}, Dark={StaticResource OnSurfaceVariantDark}}" />
                                                <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                                                    <Label Text="{Binding PreviewDurationText}"
                                                           IsVisible="{Binding HasPreviewDuration}"
                                                           FontSize="12" FontAttributes="Bold"
                                                           VerticalOptions="Center"
                                                           TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariantLight}, Dark={StaticResource OnSurfaceVariantDark}}" />
                                                    <Label Text="{Binding PreviewQuality}"
                                                           IsVisible="{Binding HasPreviewQuality}"
                                                           FontSize="12"
                                                           VerticalOptions="Center"
                                                           TextColor="{AppThemeBinding Light={StaticResource PrimaryVariantLight}, Dark={StaticResource PrimaryDark}}" />
                                                </HorizontalStackLayout>
                                            </VerticalStackLayout>

                                        <!-- Information: opens a modal popup that
                                             fetches and shows the full metadata -->
                                        <Border Grid.Row="1" HorizontalOptions="Start"
                                                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceVariantLight}, Dark={StaticResource SurfaceVariantDark}}"
                                                StrokeThickness="0" StrokeShape="RoundRectangle 12"
                                                Padding="18,0" HeightRequest="44"
                                                VerticalOptions="Center"
                                                SemanticProperties.Description="Show full metadata for this resource">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding OpenInfoCommand}" />
                                            </Border.GestureRecognizers>
                                            <Border.VisualStateManager.VisualStateGroups>
                                                <VisualStateGroupList>
                                                    <VisualStateGroup Name="CommonStates">
                                                        <VisualState Name="Normal" />
                                                        <VisualState Name="Pressed">
                                                            <VisualState.Setters>
                                                                <Setter Property="Scale" Value="0.97" />
                                                                <Setter Property="Opacity" Value="0.85" />
                                                            </VisualState.Setters>
                                                        </VisualState>
                                                    </VisualStateGroup>
                                                </VisualStateGroupList>
                                            </Border.VisualStateManager.VisualStateGroups>
                                            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                                <Path Fill="Transparent"
                                                      Stroke="{AppThemeBinding Light={StaticResource OnSurfaceLight}, Dark={StaticResource OnSurfaceDark}}"
                                                      StrokeThickness="1.8" StrokeLineCap="Round" StrokeLineJoin="Round"
                                                      Aspect="Uniform" WidthRequest="16" HeightRequest="16"
                                                      VerticalOptions="Center"
                                                      Data="M12 8h.01 M12 12v4 M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20z" />
                                                <Label Text="Information" FontSize="14" FontAttributes="Bold"
                                                       VerticalOptions="Center"
                                                       TextColor="{AppThemeBinding Light={StaticResource OnSurfaceLight}, Dark={StaticResource OnSurfaceDark}}" />
                                            </HorizontalStackLayout>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Preview loading / soft failure note -->
                                <ActivityIndicator IsRunning="{Binding IsPreviewLoading}"
                                                   IsVisible="{Binding IsPreviewLoading}"
                                                   Color="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}"
                                                   HorizontalOptions="Center" VerticalOptions="Center"
                                                   HeightRequest="32" WidthRequest="32" />
                                <Label Text="{Binding PreviewError}"
                                       IsVisible="{Binding ShowPreviewError}"
                                       Style="{StaticResource CaptionLabel}"
                                       HorizontalOptions="Center"
                                       Margin="0,-8,0,0" />

                                <!-- Save folder -->
                                <VerticalStackLayout Spacing="8">
                                    <Label Text="Save to" Style="{StaticResource FieldLabel}" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <Border Style="{StaticResource InputContainer}">
                                            <Label Text="{Binding OutputPathDisplay}"
                                                   Style="{StaticResource InputEntry}"
                                                   VerticalOptions="Center"
                                                   LineBreakMode="TailTruncation"
                                                   SemanticProperties.Hint="Folder where the file will be saved" />
                                        </Border>
                                        <Button Grid.Column="1" Text="Browse..."
                                                Command="{Binding PickFolderCommand}"
                                                Style="{StaticResource SecondaryButton}"
                                                VerticalOptions="Center"
                                                SemanticProperties.Description="Choose the folder where files will be saved" />
                                    </Grid>
                                </VerticalStackLayout>

                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Grid>
        </ScrollView>

        <!-- ================= Activity log ================= -->
        <Border Grid.Row="2" IsVisible="{Binding HasLogs}"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceContainerLight}, Dark={StaticResource SurfaceContainerDark}}"
                StrokeThickness="0" Padding="32,14,32,16">
            <Border.Triggers>
                <DataTrigger TargetType="Border" Binding="{Binding HasLogs}" Value="True">
                    <DataTrigger.EnterActions>
                        <anim:FadeInAction />
                    </DataTrigger.EnterActions>
                </DataTrigger>
            </Border.Triggers>
            <VerticalStackLayout Spacing="8">
                <Label Text="Recent activity" FontSize="12" FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariantLight}, Dark={StaticResource OnSurfaceVariantDark}}" />
                <CollectionView ItemsSource="{Binding Logs}"
                                ItemTemplate="{StaticResource LogEntryTemplate}"
                                HeightRequest="148"
                                SelectionMode="None" />
            </VerticalStackLayout>
        </Border>

        <!-- ================= Footer ================= -->
        <Label Grid.Row="3" Text="{Binding VersionText}"
               Style="{StaticResource CaptionLabel}"
               FontSize="12"
               HorizontalOptions="Center"
               Padding="0,10,0,12" />
    </Grid>
</ContentPage>
