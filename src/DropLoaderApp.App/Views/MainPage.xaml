<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DropLoaderApp.ViewModels"
             x:Class="DropLoaderApp.Views.MainPage"
             x:DataType="vm:MainViewModel"
             BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}"
             Shell.NavBarIsVisible="False"
             Shell.FlyoutBehavior="Disabled"
             WidthRequest="680"
             HeightRequest="480">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Banner -->
        <Border Grid.Row="0" Style="{StaticResource BannerBorder}">
            <Grid ColumnDefinitions="Auto,*,Auto" HeightRequest="48">
                <!-- Logo + Title -->
                <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                    <Image Source="logo.jpg" HeightRequest="32" WidthRequest="32" />
                    <Label Text="DropLoader" Style="{StaticResource TitleLabel}" FontSize="20" VerticalOptions="Center" />
                </HorizontalStackLayout>

                <!-- Theme toggle button -->
                <Button Grid.Column="2"
                        Text="{Binding SelectedTabIndex, Converter={StaticResource IntToThemeConverter}}"
                        Command="{Binding ToggleThemeCommand}"
                        Style="{StaticResource IconButton}"
                        VerticalOptions="Center" />
            </Grid>
        </Border>

        <!-- Content -->
        <VerticalStackLayout Grid.Row="1" VerticalOptions="Center" HorizontalOptions="Center"
                             Spacing="16" Padding="40" MaximumWidthRequest="560">

            <!-- URL section -->
            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Download media from TikTok, YouTube, SoundCloud"
                           Style="{StaticResource TitleLabel}" FontSize="18" />

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Paste URL" Style="{StaticResource FieldLabel}" />
                        <Entry Text="{Binding Url}" Placeholder="https://www.tiktok.com/..."
                               Style="{StaticResource InputEntry}" />
                    </VerticalStackLayout>

                    <!-- Platform indicator -->
                    <HorizontalStackLayout Spacing="6" IsVisible="{Binding Url, Converter={StaticResource StringNotEmptyConverter}}">
                        <Label Text="Detected:" Style="{StaticResource CaptionLabel}" VerticalOptions="Center" />
                        <Label Text="{Binding PlatformName}" Style="{StaticResource CaptionLabel}"
                               FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <!-- Save path -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Save to" Style="{StaticResource FieldLabel}" />
                            <Entry Text="{Binding OutputPath}" IsReadOnly="True" Style="{StaticResource InputEntry}" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Text="..."
                                Command="{Binding PickFolderCommand}"
                                WidthRequest="44" HeightRequest="44"
                                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceVariantLight}, Dark={StaticResource SurfaceVariantDark}}"
                                TextColor="{AppThemeBinding Light={StaticResource OnSurfaceLight}, Dark={StaticResource OnSurfaceDark}}"
                                CornerRadius="8"
                                VerticalOptions="End" />
                    </Grid>

                    <!-- Download button -->
                    <Button Text="{Binding IsDownloading, Converter={StaticResource BoolToStringConverter}, ConverterParameter=Downloading...}"
                            Command="{Binding DownloadCommand}"
                            IsEnabled="{Binding IsDownloading, Converter={StaticResource InverseBoolConverter}}"
                            Style="{StaticResource PrimaryButton}"
                            Margin="0,8,0,0" />
                </VerticalStackLayout>
            </Border>

            <!-- Progress section (visible during download) -->
            <Border Style="{StaticResource CardBorder}" IsVisible="{Binding IsDownloading}">
                <VerticalStackLayout Spacing="10">
                    <ProgressBar Progress="{Binding Progress}" />
                    <Label Text="{Binding Status}" Style="{StaticResource CaptionLabel}" HorizontalOptions="Center" />
                    <Button Text="Cancel" Command="{Binding CancelDownloadCommand}"
                            BackgroundColor="Transparent"
                            TextColor="{AppThemeBinding Light={StaticResource ErrorLight}, Dark={StaticResource ErrorDark}}"
                            FontSize="13" HeightRequest="32" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>

        <!-- Footer -->
        <Label Grid.Row="2" Text="DropLoader v2.0 | daniel-skliphosovsky"
               Style="{StaticResource CaptionLabel}" HorizontalOptions="Center" Padding="0,8" />
    </Grid>
</ContentPage>
