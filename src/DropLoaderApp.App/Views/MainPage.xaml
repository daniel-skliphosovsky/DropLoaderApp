<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DropLoaderApp.ViewModels"
             xmlns:anim="clr-namespace:DropLoaderApp.Animations"
             x:Class="DropLoaderApp.Views.MainPage"
             x:DataType="vm:MainViewModel"
             BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}"
             Shell.NavBarIsVisible="False"
             Shell.FlyoutBehavior="Disabled">

    <Border StrokeThickness="0"
            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
            WidthRequest="680" HeightRequest="480">
        <Grid RowDefinitions="Auto,*,Auto">

            <!-- Header -->
            <Border Grid.Row="0" StrokeThickness="0"
                    BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}"
                    Padding="20,12">
                <Grid ColumnDefinitions="Auto,*,Auto">

                    <!-- Logo + Title -->
                    <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                        <Image Source="logo.jpg" HeightRequest="36" WidthRequest="36" />
                        <VerticalStackLayout VerticalOptions="Center">
                            <Label Text="DropLoader" FontSize="22" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource OnSurfaceLight}, Dark={StaticResource OnSurfaceDark}}" />
                            <Label Text="Download media from anywhere" FontSize="11"
                                   TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariantLight}, Dark={StaticResource OnSurfaceVariantDark}}" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>

                    <!-- Theme Toggle -->
                    <Button Grid.Column="2" Text="{Binding ThemeIndex, Converter={StaticResource IntToThemeConverter}}"
                            Command="{Binding ToggleThemeCommand}"
                            Style="{StaticResource IconButton}"
                            VerticalOptions="Center"
                            SemanticProperties.Description="Switch between light and dark theme" />
                </Grid>
            </Border>

            <!-- Main Content -->
            <VerticalStackLayout Grid.Row="1" VerticalOptions="Center" HorizontalOptions="Center"
                                 Spacing="16" Padding="28,8" MaximumWidthRequest="520">

                <!-- URL Input Card -->
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="14">

                        <Label Text="Paste a link to get started"
                               FontSize="16" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource OnSurfaceLight}, Dark={StaticResource OnSurfaceDark}}" />

                        <!-- URL Entry -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Link" Style="{StaticResource FieldLabel}" />
                            <Border Stroke="{AppThemeBinding Light={StaticResource OutlineLight}, Dark={StaticResource OutlineDark}}"
                                    StrokeThickness="1" StrokeShape="RoundRectangle 8"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceVariantLight}, Dark={StaticResource SurfaceVariantDark}}"
                                    HeightRequest="44">
                                <Entry Text="{Binding Url}"
                                       Placeholder="Paste a media link, e.g. https://..."
                                       Keyboard="Url"
                                       IsEnabled="{Binding IsDownloading, Converter={StaticResource InverseBoolConverter}}"
                                       Style="{StaticResource InputEntry}"
                                       BackgroundColor="Transparent"
                                       SemanticProperties.Hint="Paste a TikTok, YouTube or SoundCloud link" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Platform badge -->
                        <Border IsVisible="{Binding ShowPlatformBadge}"
                                StrokeThickness="0"
                                BackgroundColor="{AppThemeBinding Light=#F0EEFF, Dark=#2A2540}"
                                StrokeShape="RoundRectangle 6" Padding="10,6" HeightRequest="32"
                                HorizontalOptions="Start">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border"
                                             Binding="{Binding ShowPlatformBadge}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <anim:FadeInAction />
                                    </DataTrigger.EnterActions>
                                </DataTrigger>
                            </Border.Triggers>
                            <HorizontalStackLayout Spacing="6">
                                <Label Text="Platform:" FontSize="11"
                                       TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariantLight}, Dark={StaticResource OnSurfaceVariantDark}}"
                                       VerticalOptions="Center" />
                                <Label Text="{Binding PlatformName}" FontSize="11" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>

                        <!-- Save path with picker -->
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Save to" Style="{StaticResource FieldLabel}" />
                                <Border Stroke="{AppThemeBinding Light={StaticResource OutlineLight}, Dark={StaticResource OutlineDark}}"
                                        StrokeThickness="1" StrokeShape="RoundRectangle 8"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceVariantLight}, Dark={StaticResource SurfaceVariantDark}}"
                                        HeightRequest="44">
                                    <Entry Text="{Binding OutputPath}" IsReadOnly="True"
                                           Style="{StaticResource InputEntry}"
                                           BackgroundColor="Transparent" />
                                </Border>
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="Browse"
                                    Command="{Binding PickFolderCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    WidthRequest="84" VerticalOptions="End"
                                    SemanticProperties.Description="Choose the folder where files will be saved" />
                        </Grid>

                        <!-- Download Button -->
                        <Button Text="Download"
                                Command="{Binding DownloadCommand}"
                                Style="{StaticResource PrimaryButton}"
                                SemanticProperties.Description="Start downloading the media" />

                        <!-- Progress section (visible while downloading) -->
                        <VerticalStackLayout Spacing="10"
                                             IsVisible="{Binding IsDownloading}"
                                             Margin="0,4,0,0">
                            <VerticalStackLayout.Triggers>
                                <DataTrigger TargetType="VerticalStackLayout"
                                             Binding="{Binding IsDownloading}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <anim:FadeInAction />
                                    </DataTrigger.EnterActions>
                                </DataTrigger>
                            </VerticalStackLayout.Triggers>

                            <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                                <Label Text="{Binding Status}" Style="{StaticResource CaptionLabel}" />
                                <Label Text="{Binding Progress, StringFormat='{0:P0}'}" Style="{StaticResource CaptionLabel}"
                                       FontAttributes="Bold" />
                            </HorizontalStackLayout>

                            <ProgressBar Progress="{Binding Progress}"
                                         HeightRequest="6"
                                         ProgressColor="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />

                            <Button Text="Cancel" Command="{Binding CancelDownloadCommand}"
                                    Style="{StaticResource DangerButton}"
                                    HorizontalOptions="Center" WidthRequest="120"
                                    SemanticProperties.Description="Cancel the current download" />
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>

            <!-- Footer -->
            <Label Grid.Row="2" Text="DropLoader v2.1 | daniel-skliphosovsky"
                   Style="{StaticResource CaptionLabel}" HorizontalOptions="Center" Padding="0,10,0,8"
                   FontSize="10" />
        </Grid>
    </Border>
</ContentPage>
