<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DropLoader.ViewModels"
             xmlns:anim="clr-namespace:DropLoader.Animations"
             x:Class="DropLoader.Views.MainPage"
             x:DataType="vm:MainViewModel"
             BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}"
             Shell.NavBarIsVisible="False"
             Shell.FlyoutBehavior="Disabled">

    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="0">

        <!-- ================= Header ================= -->
        <Border Grid.Row="0" StrokeThickness="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16"
                  Padding="28,18,28,16">

                <HorizontalStackLayout Spacing="14" VerticalOptions="Center">
                    <Border StrokeThickness="0" Padding="0" WidthRequest="48" HeightRequest="48"
                            StrokeShape="RoundRectangle 14"
                            BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryContainerLight}, Dark={StaticResource PrimaryContainerDark}}"
                            VerticalOptions="Center">
                        <Image Source="logo.jpg" WidthRequest="30" HeightRequest="30" Aspect="AspectFit" />
                    </Border>
                    <VerticalStackLayout VerticalOptions="Center" Spacing="1">
                        <Label Text="DropLoader" Style="{StaticResource AppTitleLabel}" />
                        <Label Text="Download media from TikTok, YouTube and SoundCloud"
                               Style="{StaticResource AppSubtitleLabel}" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>

                <!-- Theme toggle -->
                <Border Grid.Column="2" Style="{StaticResource IconButton}" VerticalOptions="Center"
                        SemanticProperties.Description="Switch between light and dark theme">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleThemeCommand}" />
                    </Border.GestureRecognizers>
                    <Grid WidthRequest="22" HeightRequest="22">
                        <!-- Moon (shown in light theme) -->
                        <Path Fill="Transparent" IsVisible="False"
                              Stroke="{AppThemeBinding Light={StaticResource OnSurfaceLight}, Dark={StaticResource OnSurfaceDark}}"
                              StrokeThickness="2" StrokeLineCap="Round" StrokeLineJoin="Round"
                              Aspect="Uniform"
                              Data="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z">
                            <Path.Triggers>
                                <DataTrigger TargetType="Path" Binding="{Binding ThemeIndex}" Value="0">
                                    <Setter Property="IsVisible" Value="True" />
                                </DataTrigger>
                            </Path.Triggers>
                        </Path>
                        <!-- Sun (shown in dark theme) -->
                        <Path Fill="Transparent" IsVisible="False"
                              Stroke="{AppThemeBinding Light={StaticResource OnSurfaceLight}, Dark={StaticResource OnSurfaceDark}}"
                              StrokeThickness="2" StrokeLineCap="Round"
                              Aspect="Uniform"
                              Data="M12 3v1 M12 20v1 M3 12h1 M20 12h1 M5.6 5.6l.7.7 M17.7 17.7l.7.7 M5.6 18.4l.7-.7 M17.7 6.3l.7-.7">
                            <Path.Triggers>
                                <DataTrigger TargetType="Path" Binding="{Binding ThemeIndex}" Value="1">
                                    <Setter Property="IsVisible" Value="True" />
                                </DataTrigger>
                            </Path.Triggers>
                        </Path>
                    </Grid>
                </Border>
            </Grid>
        </Border>
        <BoxView Grid.Row="0" HeightRequest="1" VerticalOptions="End"
                 Color="{AppThemeBinding Light={StaticResource DividerLight}, Dark={StaticResource DividerDark}}" />

        <!-- ================= Main content ================= -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="28,32,28,24" Spacing="0"
                                 MaximumWidthRequest="560" HorizontalOptions="Center">
                <VerticalStackLayout Spacing="24">

                    <!-- Card -->
                    <Border x:Name="Card" Style="{StaticResource CardBorder}" Opacity="0">
                        <VerticalStackLayout Spacing="22">

                            <Label Text="New download" Style="{StaticResource SectionTitleLabel}" />

                            <!-- URL field -->
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Media link" Style="{StaticResource FieldLabel}" />
                                <Border Style="{StaticResource InputContainer}">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">

                                        <!-- Platform icon, auto-detected -->
                                        <Grid Grid.Column="0" WidthRequest="20" HeightRequest="20"
                                              VerticalOptions="Center" Margin="12,0,0,0">
                                            <!-- Unknown: generic link -->
                                            <Path Fill="Transparent" IsVisible="False"
                                                  Stroke="{AppThemeBinding Light={StaticResource OnSurfaceVariantLight}, Dark={StaticResource OnSurfaceVariantDark}}"
                                                  StrokeThickness="1.8" StrokeLineCap="Round" StrokeLineJoin="Round"
                                                  Aspect="Uniform"
                                                  Data="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71 M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71">
                                                <Path.Triggers>
                                                    <DataTrigger TargetType="Path" Binding="{Binding PlatformKey}" Value="unknown">
                                                        <Setter Property="IsVisible" Value="True" />
                                                    </DataTrigger>
                                                </Path.Triggers>
                                            </Path>
                                            <!-- TikTok: music note -->
                                            <Path Fill="Transparent" IsVisible="False"
                                                  Stroke="{AppThemeBinding Light={StaticResource TikTokLight}, Dark={StaticResource TikTokDark}}"
                                                  StrokeThickness="1.8" StrokeLineCap="Round" StrokeLineJoin="Round"
                                                  Aspect="Uniform"
                                                  Data="M9 18V5l12-2v13 M9 18a3 3 0 1 1-6 0 3 3 0 0 1 6 0z M21 16a3 3 0 1 1-6 0 3 3 0 0 1 6 0z">
                                                <Path.Triggers>
                                                    <DataTrigger TargetType="Path" Binding="{Binding PlatformKey}" Value="tiktok">
                                                        <Setter Property="IsVisible" Value="True" />
                                                    </DataTrigger>
                                                </Path.Triggers>
                                            </Path>
                                            <!-- YouTube: rounded rect -->
                                            <Path Fill="Transparent" IsVisible="False"
                                                  Stroke="{AppThemeBinding Light={StaticResource YouTubeLight}, Dark={StaticResource YouTubeDark}}"
                                                  StrokeThickness="1.8" StrokeLineCap="Round" StrokeLineJoin="Round"
                                                  Aspect="Uniform"
                                                  Data="M4 6a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2z">
                                                <Path.Triggers>
                                                    <DataTrigger TargetType="Path" Binding="{Binding PlatformKey}" Value="youtube">
                                                        <Setter Property="IsVisible" Value="True" />
                                                    </DataTrigger>
                                                </Path.Triggers>
                                            </Path>
                                            <!-- YouTube: play triangle -->
                                            <Path Fill="{AppThemeBinding Light={StaticResource YouTubeLight}, Dark={StaticResource YouTubeDark}}" IsVisible="False"
                                                  StrokeThickness="0" Aspect="Uniform"
                                                  Data="M10 9.5v5l4.5-2.5z">
                                                <Path.Triggers>
                                                    <DataTrigger TargetType="Path" Binding="{Binding PlatformKey}" Value="youtube">
                                                        <Setter Property="IsVisible" Value="True" />
                                                    </DataTrigger>
                                                </Path.Triggers>
                                            </Path>
                                            <!-- SoundCloud: sound waves -->
                                            <Path Fill="Transparent" IsVisible="False"
                                                  Stroke="{AppThemeBinding Light={StaticResource SoundCloudLight}, Dark={StaticResource SoundCloudDark}}"
                                                  StrokeThickness="2" StrokeLineCap="Round"
                                                  Aspect="Uniform"
                                                  Data="M2 13v-2 M5 13V9 M8 13V6 M11 13V8 M14 13v-3">
                                                <Path.Triggers>
                                                    <DataTrigger TargetType="Path" Binding="{Binding PlatformKey}" Value="soundcloud">
                                                        <Setter Property="IsVisible" Value="True" />
                                                    </DataTrigger>
                                                </Path.Triggers>
                                            </Path>
                                        </Grid>

                                        <Entry Grid.Column="1"
                                               Text="{Binding Url}"
                                               Placeholder="Paste a link to a video, track or photo set..."
                                               Keyboard="Url"
                                               IsEnabled="{Binding IsDownloading, Converter={StaticResource InverseBoolConverter}}"
                                               Style="{StaticResource InputEntry}"
                                               VerticalOptions="Center"
                                               SemanticProperties.Hint="Paste a TikTok, YouTube or SoundCloud link" />
                                    </Grid>
                                </Border>

                                <!-- Platform chip -->
                                <Border Style="{StaticResource ChipStyle}"
                                        IsVisible="{Binding ShowPlatformBadge}"
                                        HorizontalOptions="Start">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border"
                                                     Binding="{Binding ShowPlatformBadge}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <anim:FadeInAction />
                                            </DataTrigger.EnterActions>
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding PlatformKey}" Value="tiktok">
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource TikTokContainerLight}, Dark={StaticResource TikTokContainerDark}}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding PlatformKey}" Value="youtube">
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource YouTubeContainerLight}, Dark={StaticResource YouTubeContainerDark}}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding PlatformKey}" Value="soundcloud">
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SoundCloudContainerLight}, Dark={StaticResource SoundCloudContainerDark}}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Label Text="{Binding PlatformName}" FontSize="12" FontAttributes="Bold" VerticalOptions="Center">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding PlatformKey}" Value="tiktok">
                                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnTikTokContainerLight}, Dark={StaticResource OnTikTokContainerDark}}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding PlatformKey}" Value="youtube">
                                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnYouTubeContainerLight}, Dark={StaticResource OnYouTubeContainerDark}}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding PlatformKey}" Value="soundcloud">
                                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnSoundCloudContainerLight}, Dark={StaticResource OnSoundCloudContainerDark}}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Border>
                            </VerticalStackLayout>

                            <!-- Save folder -->
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Save to" Style="{StaticResource FieldLabel}" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <Border Style="{StaticResource InputContainer}">
                                        <Label Text="{Binding OutputPathDisplay}"
                                               Style="{StaticResource InputEntry}"
                                               VerticalOptions="Center"
                                               LineBreakMode="TailTruncation"
                                               SemanticProperties.Hint="Folder where the file will be saved" />
                                    </Border>
                                    <Button Grid.Column="1" Text="Browse..."
                                            Command="{Binding PickFolderCommand}"
                                            Style="{StaticResource SecondaryButton}"
                                            VerticalOptions="Center"
                                            SemanticProperties.Description="Choose the folder where files will be saved" />
                                </Grid>
                            </VerticalStackLayout>

                            <!-- Download -->
                            <Button Style="{StaticResource DownloadButton}"
                                    Text="Download"
                                    ImageSource="{AppThemeBinding Light=download_light.svg, Dark=download_dark.svg}"
                                    ContentLayout="Left,8"
                                    IsEnabled="{Binding CanStartDownload}"
                                    Command="{Binding DownloadCommand}"
                                    HorizontalOptions="Fill"
                                    SemanticProperties.Description="Start downloading the media" />

                            <!-- Progress section (visible while downloading) -->
                            <VerticalStackLayout Spacing="12"
                                                 IsVisible="{Binding IsDownloading}">
                                <VerticalStackLayout.Triggers>
                                    <DataTrigger TargetType="VerticalStackLayout"
                                                 Binding="{Binding IsDownloading}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <anim:FadeInAction />
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>
                                </VerticalStackLayout.Triggers>

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <Label Text="{Binding ProgressText}"
                                           Style="{StaticResource CaptionLabel}"
                                           LineBreakMode="TailTruncation"
                                           VerticalOptions="Center" />
                                    <Label Grid.Column="1"
                                           Text="{Binding Progress, StringFormat='{0:P0}'}"
                                           Style="{StaticResource CaptionLabel}"
                                           FontAttributes="Bold" VerticalOptions="Center" />
                                </Grid>

                                <ProgressBar Progress="{Binding Progress}"
                                             Style="{StaticResource ProgressBarStyle}" />

                                <Button Text="Cancel"
                                        Command="{Binding CancelDownloadCommand}"
                                        Style="{StaticResource DangerButton}"
                                        HorizontalOptions="Center"
                                        WidthRequest="140"
                                        SemanticProperties.Description="Cancel the current download" />
                            </VerticalStackLayout>

                            <!-- Status message -->
                            <Border IsVisible="{Binding ShowStatus}"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceContainerLight}, Dark={StaticResource SurfaceContainerDark}}"
                                    StrokeThickness="0" Padding="14,12"
                                    StrokeShape="RoundRectangle 12"
                                    HorizontalOptions="Fill">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border"
                                                 Binding="{Binding ShowStatus}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <anim:FadeInAction />
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>
                                    <DataTrigger TargetType="Border" Binding="{Binding StatusKind}" Value="success">
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SuccessContainerLight}, Dark={StaticResource SuccessContainerDark}}" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Border" Binding="{Binding StatusKind}" Value="error">
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ErrorContainerLight}, Dark={StaticResource ErrorContainerDark}}" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Border" Binding="{Binding StatusKind}" Value="muted">
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceVariantLight}, Dark={StaticResource SurfaceVariantDark}}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <!-- Success: check -->
                                    <Path Grid.Column="0" Fill="Transparent" IsVisible="False"
                                          Stroke="{AppThemeBinding Light={StaticResource OnSuccessContainerLight}, Dark={StaticResource OnSuccessContainerDark}}"
                                          StrokeThickness="2.2" StrokeLineCap="Round" StrokeLineJoin="Round"
                                          Aspect="Uniform" WidthRequest="18" HeightRequest="18"
                                          VerticalOptions="Center"
                                          Data="M20 6L9 17l-5-5">
                                        <Path.Triggers>
                                            <DataTrigger TargetType="Path" Binding="{Binding StatusKind}" Value="success">
                                                <Setter Property="IsVisible" Value="True" />
                                            </DataTrigger>
                                        </Path.Triggers>
                                    </Path>
                                    <!-- Error: alert -->
                                    <Path Grid.Column="0" Fill="Transparent" IsVisible="False"
                                          Stroke="{AppThemeBinding Light={StaticResource OnErrorContainerLight}, Dark={StaticResource OnErrorContainerDark}}"
                                          StrokeThickness="2.2" StrokeLineCap="Round" StrokeLineJoin="Round"
                                          Aspect="Uniform" WidthRequest="18" HeightRequest="18"
                                          VerticalOptions="Center"
                                          Data="M12 9v4 M12 17h.01 M12 3l9 16a1 1 0 0 1-.87 1.5H3.87a1 1 0 0 1-.87-1.5z">
                                        <Path.Triggers>
                                            <DataTrigger TargetType="Path" Binding="{Binding StatusKind}" Value="error">
                                                <Setter Property="IsVisible" Value="True" />
                                            </DataTrigger>
                                        </Path.Triggers>
                                    </Path>
                                    <!-- Cancelled: x -->
                                    <Path Grid.Column="0" Fill="Transparent" IsVisible="False"
                                          Stroke="{AppThemeBinding Light={StaticResource OnSurfaceVariantLight}, Dark={StaticResource OnSurfaceVariantDark}}"
                                          StrokeThickness="2.2" StrokeLineCap="Round"
                                          Aspect="Uniform" WidthRequest="18" HeightRequest="18"
                                          VerticalOptions="Center"
                                          Data="M18 6L6 18 M6 6l12 12">
                                        <Path.Triggers>
                                            <DataTrigger TargetType="Path" Binding="{Binding StatusKind}" Value="muted">
                                                <Setter Property="IsVisible" Value="True" />
                                            </DataTrigger>
                                        </Path.Triggers>
                                    </Path>
                                    <Label Grid.Column="1"
                                           Text="{Binding Status}"
                                           FontSize="13" FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariantLight}, Dark={StaticResource OnSurfaceVariantDark}}"
                                           VerticalOptions="Center"
                                           LineBreakMode="WordWrap">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding StatusKind}" Value="success">
                                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnSuccessContainerLight}, Dark={StaticResource OnSuccessContainerDark}}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding StatusKind}" Value="error">
                                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnErrorContainerLight}, Dark={StaticResource OnErrorContainerDark}}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding StatusKind}" Value="muted">
                                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnSurfaceVariantLight}, Dark={StaticResource OnSurfaceVariantDark}}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Grid>
                            </Border>

                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- ================= Footer ================= -->
        <Label Grid.Row="2" Text="{Binding VersionText}"
               Style="{StaticResource CaptionLabel}"
               FontSize="11"
               HorizontalOptions="Center"
               Padding="0,10,0,12" />
    </Grid>
</ContentPage>
